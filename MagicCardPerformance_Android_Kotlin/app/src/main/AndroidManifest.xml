<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 录音权限：用于魔术暗语“确定”的语音识别 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- 读取相册图片权限：Android 13 (API 33) 及以上 -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- 读取存储权限：Android 12 及以下兼容 -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- 触觉震动权限：魔术暗语触发时给表演者掌心隐蔽轻微震动反馈 -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Android 11 (API 30)+ 软件包可见性查询声明：确保 SpeechRecognizer 能够与系统语音识别服务正常交互 -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@android:drawable/ic_menu_gallery"
        android:label="@string/app_name"
        android:roundIcon="@android:drawable/ic_menu_gallery"
        android:supportsRtl="true"
        android:theme="@style/Theme.MagicCardPerformance">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>